# Copy to .env.development.local (git-ignored). Demo values only.

# orion-bank-api origin. Defaults: http://localhost:8000 in development,
# https://orion-project-backend-production.up.railway.app in production.
# Read by `next build` for the /api/v1 rewrite, so set it before building.
API_URL=http://localhost:8000

# Optional: the API seed's DEMO_PASSWORD, filled in by the demo-account buttons on sign-in.
NEXT_PUBLIC_DEMO_PASSWORD=
